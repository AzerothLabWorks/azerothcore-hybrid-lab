+void Player::ApplyHybridResourceSupport(bool fillCurrent)
 {
     if (!sWorld->getBoolConfig(CONFIG_HYBRID_RESOURCES_ENABLE))
         return;
 
     uint32 const minMana = sWorld->getIntConfig(CONFIG_HYBRID_RESOURCES_MIN_MANA);
     if (minMana)
