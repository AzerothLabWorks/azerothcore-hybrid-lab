+        if (GetCreateMana() < minMana)
+            SetCreateMana(minMana);
 
-        if (player->GetMaxPower(POWER_MANA) < minMana)
-            player->SetMaxPower(POWER_MANA, minMana);
+        if (GetMaxPower(POWER_MANA) < minMana)
