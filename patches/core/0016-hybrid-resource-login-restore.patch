+            SetPower(POWER_MANA, GetMaxPower(POWER_MANA));
     }
 
     uint32 const maxEnergy = sWorld->getIntConfig(CONFIG_HYBRID_RESOURCES_MAX_ENERGY);
-    if (maxEnergy && player->GetMaxPower(POWER_ENERGY) < maxEnergy)
+    if (maxEnergy && GetMaxPower(POWER_ENERGY) < maxEnergy)
     {
-        player->SetMaxPower(POWER_ENERGY, maxEnergy);
+        SetMaxPower(POWER_ENERGY, maxEnergy);
 
-        if (fillCurrent || player->GetPower(POWER_ENERGY) > maxEnergy)
-            player->SetPower(POWER_ENERGY, maxEnergy);
+        if (fillCurrent || GetPower(POWER_ENERGY) > maxEnergy)
+            SetPower(POWER_ENERGY, maxEnergy);
     }
 
     uint32 const maxRage = sWorld->getIntConfig(CONFIG_HYBRID_RESOURCES_MAX_RAGE);
-    if (maxRage && player->GetMaxPower(POWER_RAGE) < maxRage)
-        player->SetMaxPower(POWER_RAGE, maxRage);
+    if (maxRage && GetMaxPower(POWER_RAGE) < maxRage)
+        SetMaxPower(POWER_RAGE, maxRage);
 }
