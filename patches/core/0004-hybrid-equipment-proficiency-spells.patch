+static bool IsHybridEquipmentSkillLine(uint32 skillLine)
+{
+    switch (skillLine)
+    {
+        case SKILL_SWORDS:
+        case SKILL_AXES:
+        case SKILL_BOWS:
+        case SKILL_GUNS:
+        case SKILL_MACES:
+        case SKILL_2H_SWORDS:
+        case SKILL_STAVES:
+        case SKILL_2H_MACES:
+        case SKILL_UNARMED:
+        case SKILL_2H_AXES:
+        case SKILL_DAGGERS:
+        case SKILL_THROWN:
+        case SKILL_CROSSBOWS:
+        case SKILL_WANDS:
+        case SKILL_POLEARMS:
+        case SKILL_FIST_WEAPONS:
+        case SKILL_CLOTH:
+        case SKILL_LEATHER:
+        case SKILL_MAIL:
+        case SKILL_PLATE_MAIL:
+        case SKILL_SHIELD:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static bool CanUseHybridEquipmentSkillLine(uint32 skillLine)
+{
+    return sWorld->getBoolConfig(CONFIG_HYBRID_EQUIPMENT_PROFICIENCY) && IsHybridEquipmentSkillLine(skillLine);
+}
