+bool CanUseHybridEquipmentProficiency(Player const* player, ItemTemplate const* proto)
+{
+    if (!sWorld->getBoolConfig(CONFIG_HYBRID_EQUIPMENT_PROFICIENCY))
+        return false;
+
+    if (!proto || (proto->Class != ITEM_CLASS_WEAPON && proto->Class != ITEM_CLASS_ARMOR))
+        return false;
+
+    uint32 skill = proto->GetSkill();
+    return skill && player->GetSkillValue(skill) > 0;
+}
