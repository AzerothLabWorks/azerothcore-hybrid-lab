diff --git a/src/server/game/Movement/MovementGenerators/EscortMovementGenerator.cpp b/src/server/game/Movement/MovementGenerators/EscortMovementGenerator.cpp
index 6ea1d3a7ee..159ecf1c7e 100644
--- a/src/server/game/Movement/MovementGenerators/EscortMovementGenerator.cpp
+++ b/src/server/game/Movement/MovementGenerators/EscortMovementGenerator.cpp
@@ -20,6 +20,29 @@
 #include "CreatureAI.h"
 #include "MoveSplineInit.h"
 #include "Player.h"
+#include "World.h"
+
+namespace
+{
+    template<class T>
+    void ApplyEscortSpeedRate(T* unit, Movement::MoveSplineInit& init, ForcedMovement forcedMovement)
+    {
+        if (!unit || unit->IsPlayer())
+            return;
+
+        float escortRate = sWorld->getFloatConfig(CONFIG_ESCORT_MOVEMENT_SPEED_RATE);
+        if (escortRate <= 0.0f || escortRate == 1.0f)
+            return;
+
+        UnitMoveType moveType = MOVE_RUN;
+        if (forcedMovement == FORCED_MOVEMENT_WALK)
+            moveType = MOVE_WALK;
+        else if (forcedMovement == FORCED_MOVEMENT_NONE && unit->IsWalking())
+            moveType = MOVE_WALK;
+
+        init.SetVelocity(unit->GetSpeed(moveType) * escortRate);
+    }
+}
 
 template<class T>
 void EscortMovementGenerator<T>::DoInitialize(T* unit)
@@ -41,6 +64,7 @@ void EscortMovementGenerator<T>::DoInitialize(T* unit)
     else if (_forcedMovement == FORCED_MOVEMENT_RUN)
         init.SetWalk(false);
 
+    ApplyEscortSpeedRate(unit, init, _forcedMovement);
     init.Launch();
 
     _splineId = unit->movespline->GetId();
@@ -89,6 +113,7 @@ bool EscortMovementGenerator<T>::DoUpdate(T* unit, uint32  /*diff*/)
         else if (_forcedMovement == FORCED_MOVEMENT_RUN)
             init.SetWalk(false);
 
+        ApplyEscortSpeedRate(unit, init, _forcedMovement);
         init.Launch();
         // Xinef: Override spline Id on recalculate launch
         _splineId = unit->movespline->GetId();
