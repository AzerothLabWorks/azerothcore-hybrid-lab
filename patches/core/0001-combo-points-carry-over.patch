diff --git a/src/server/game/Entities/Player/Player.cpp b/src/server/game/Entities/Player/Player.cpp
index 3e65e30cb..bb1d1a3e6 100644
--- a/src/server/game/Entities/Player/Player.cpp
+++ b/src/server/game/Entities/Player/Player.cpp
@@ -11499,6 +11499,17 @@ void Player::SetSelection(ObjectGuid guid)
 {
     SetGuidValue(UNIT_FIELD_TARGET, guid);
 
+    if (sWorld->getBoolConfig(CONFIG_COMBO_POINTS_CARRY_OVER) && GetComboPoints())
+    {
+        if (Unit* target = ObjectAccessor::GetUnit(*this, guid))
+        {
+            if (target->IsAlive() && !IsFriendlyTo(target) && target->isTargetableForAttack(true, this))
+            {
+                RebindComboPoints(target);
+            }
+        }
+    }
+
     if (NeedSendSpectatorData())
         ArenaSpectator::SendCommand_GUID(FindMap(), GetGUID(), "TRG", guid);
 }
diff --git a/src/server/game/Entities/Unit/Unit.cpp b/src/server/game/Entities/Unit/Unit.cpp
index 8300ca203..f6b12f992 100644
--- a/src/server/game/Entities/Unit/Unit.cpp
+++ b/src/server/game/Entities/Unit/Unit.cpp
@@ -13239,7 +13239,15 @@ void Unit::AddComboPoints(Unit* target, int8 count)
         }
 
         m_comboTarget = target;
-        m_comboPoints = count;
+        if (IsPlayer() && sWorld->getBoolConfig(CONFIG_COMBO_POINTS_CARRY_OVER))
+        {
+            m_comboPoints = std::max<int8>(std::min<int8>(m_comboPoints + count, 5), 0);
+        }
+        else
+        {
+            m_comboPoints = count;
+        }
+
         target->AddComboPointHolder(this);
     }
     else
@@ -13267,6 +13275,35 @@ void Unit::ClearComboPoints()
     m_comboTarget = nullptr;
 }
 
+void Unit::DetachComboPoints()
+{
+    if (!m_comboTarget)
+    {
+        return;
+    }
+
+    m_comboTarget->RemoveComboPointHolder(this);
+    m_comboTarget = nullptr;
+    SendComboPoints();
+}
+
+void Unit::RebindComboPoints(Unit* target)
+{
+    if (!target || target == m_comboTarget || !m_comboPoints)
+    {
+        return;
+    }
+
+    if (m_comboTarget)
+    {
+        m_comboTarget->RemoveComboPointHolder(this);
+    }
+
+    m_comboTarget = target;
+    m_comboTarget->AddComboPointHolder(this);
+    SendComboPoints();
+}
+
 void Unit::SendComboPoints()
 {
     if (m_cleanupDone)
@@ -13309,7 +13346,15 @@ void Unit::ClearComboPointHolders()
 {
     while (!m_ComboPointHolders.empty())
     {
-        (*m_ComboPointHolders.begin())->ClearComboPoints(); // this also removes it from m_comboPointHolders
+        Unit* holder = *m_ComboPointHolders.begin();
+        if (holder->IsPlayer() && sWorld->getBoolConfig(CONFIG_COMBO_POINTS_CARRY_OVER))
+        {
+            holder->DetachComboPoints(); // this also removes it from m_ComboPointHolders
+        }
+        else
+        {
+            holder->ClearComboPoints(); // this also removes it from m_ComboPointHolders
+        }
     }
 }
 
