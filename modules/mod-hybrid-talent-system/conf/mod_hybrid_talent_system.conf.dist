#
# Hybrid Talent System
#

# Enable the module.
HybridTalentSystem.Enable = 1

# Minimum character level required to learn hybrid spells.
HybridTalentSystem.MinLevel = 10

# Hybrid points earned per eligible interval.
HybridTalentSystem.PointsPerInterval = 1

# Level interval after MinLevel. With MinLevel 10 and Interval 2, players earn at
# levels 10, 12, 14, etc.
HybridTalentSystem.PointIntervalLevels = 2

# Maximum hybrid points a character can earn.
HybridTalentSystem.MaxPoints = 35

# Minimum character level required to learn hybrid talents.
HybridTalentSystem.TalentMinLevel = 10

# Hybrid talent points earned per eligible interval.
HybridTalentSystem.TalentPointsPerInterval = 1

# Level interval after TalentMinLevel. With TalentMinLevel 10 and Interval 2,
# players earn at levels 10, 12, 14, etc.
HybridTalentSystem.TalentPointIntervalLevels = 2

# Maximum hybrid talent points a character can earn.
HybridTalentSystem.TalentMaxPoints = 35

# Copper cost to reset all hybrid spells.
# 10000 copper = 1 gold.
HybridTalentSystem.ResetCostCopper = 100000

# Creature entry used as the Hybrid Talent Master NPC.
HybridTalentSystem.TrainerNpcEntry = 190010

# Optional quality-of-life item that summons the Hybrid Talent Master near the player.
HybridTalentSystem.BeaconItemEntry = 1915
HybridTalentSystem.GrantBeaconOnLogin = 1
HybridTalentSystem.BeaconSummonDurationSeconds = 300

# Restore persisted hybrid spells when players and playerbots log in.
HybridTalentSystem.RestoreOnLogin = 1

# Automatically upgrade purchased hybrid spells to the best known rank for the
# player's level on login and level-up.
HybridTalentSystem.AutoUpgradeRanks = 1

# Mirror selected self-cast friendly buff spell families onto the player's
# active pet. This supports hybrid builds that use hunter beasts or warlock
# demons.
HybridTalentSystem.MirrorPetBuffs = 1

# Comma-separated spell IDs to mirror to pets. Only the first rank of each
# spell family is required; higher ranks are matched automatically.
# Defaults include Fortitude, Spirit, Shadow Protection, Arcane Intellect,
# Arcane Brilliance, Dampen/Amplify Magic, Blessings, Mark/Gift, and Thorns.
HybridTalentSystem.PetBuffSpellIds = "1243,21562,14752,27681,976,27683,1459,23028,604,1008,19740,25782,19742,25894,20217,25898,1126,21849,467"

# Semicolon-separated dependency grant rules. Each rule is trigger:grant,grant.
# When a hybrid spell is learned, listed support spells are learned for free and
# tracked so they can be safely removed if the trigger spell is unlearned.
# Default: Tame Beast grants Call Pet, Dismiss Pet, Revive Pet, Feed Pet,
# Beast Training, and Eye of the Beast.
HybridTalentSystem.SpellDependencyGrants = "1515:883,2641,982,6991,5149,1002"

# Learn synergy reward spells when requirements are met.
HybridTalentSystem.EnableSynergies = 1
